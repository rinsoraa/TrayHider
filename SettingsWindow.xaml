<Window x:Class="TrayHider.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:TrayHider.Services"
        Title="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Title]}"
        Width="600" Height="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize.Body}"
        Foreground="{DynamicResource App.TextPrimary}"
        UseLayoutRounding="True"
        WindowStyle="None">

    <Border Background="{DynamicResource App.Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="48" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Title]}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource App.FontSize.Subtitle}"
                           FontWeight="SemiBold" />
                <Button Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,8,0"
                        Click="Close_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="20,4,20,24">

                    <!-- ==================== 启动与后台 ==================== -->
                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Group.Startup]}"
                               Margin="2,0,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <StackPanel>
                            <!-- 开机自启 -->
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.AutoStart.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.AutoStart.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="14,0" />

                            <!-- 隐藏自身托盘图标 -->
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.HideSelfTray.Title]}" />
                                    <TextBlock Text="{Binding SelfIconHint}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding HideSelfTrayIcon, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="14,0" />

                            <!-- 关闭行为 -->
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.MinimizeToTray.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.MinimizeToTray.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 窗口隐藏 ==================== -->
                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Group.WindowHiding]}"
                               Margin="2,22,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border x:Name="WindowOptionsCard"
                            Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <StackPanel>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.HideAppTrayWithWindow.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.HideAppTrayWithWindow.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding HideAppTrayIconWithWindow, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="14,0" />

                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.RestoreWindowsOnExit.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.RestoreWindowsOnExit.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding RestoreWindowsOnExit, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 权限 ==================== -->
                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Group.Permission]}"
                               Margin="2,22,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Permission.Current]}" />
                                <TextBlock Text="{Binding ElevationHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource App.FontSize.Caption}"
                                           Foreground="{DynamicResource App.TextTertiary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="RelaunchElevatedButton"
                                    Content="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Permission.Relaunch]}"
                                    Style="{StaticResource StandardButton}"
                                    VerticalAlignment="Center"
                                    Click="RelaunchElevated_Click" />
                        </Grid>
                    </Border>

                    <!-- ==================== 界面与运行方式 ==================== -->
                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Language.Group]}"
                               Margin="2,22,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <StackPanel>
                            <!-- 语言 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Language.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Language.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageCombo"
                                          Grid.Column="1"
                                          Width="168"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding LanguageOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedLanguageValue, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="0,14,0,14" />

                            <!-- 隐藏图标后退出（不常驻）：功能已实现，但本机端到端验证未通过（置位后图标仍显示），
                                 在验证通过前不向用户暴露，避免"以为隐藏了其实没有"。 -->
                            <Grid Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.RunOnce.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.RunOnce.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox x:Name="RunOnceToggle"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding RunOnceEnabled, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 快捷键 ==================== -->
                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Group.Hotkeys]}"
                               Margin="2,22,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10">
                        <StackPanel>
                        <ItemsControl x:Name="HotkeyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Description}"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource App.FontSize.Caption}"
                                                       Foreground="{DynamicResource App.TextTertiary}" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource App.ControlFill}"
                                                BorderBrush="{DynamicResource App.Border}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,5"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Text}"
                                                       FontFamily="Consolas"
                                                       FontSize="{DynamicResource App.FontSize.Caption}" />
                                        </Border>

                                        <Button Grid.Column="2"
                                                Content="×"
                                                Style="{StaticResource StandardButton}"
                                                MinWidth="30"
                                                Padding="8,3"
                                                Margin="0,0,8,0"
                                                ToolTip="{Binding ClearTip}"
                                                Visibility="{Binding ClearButtonVisibility}"
                                                VerticalAlignment="Center"
                                                Click="HotkeyClear_Click" />

                                        <Button Grid.Column="3"
                                                Content="{Binding ButtonText}"
                                                Style="{StaticResource StandardButton}"
                                                MinWidth="96"
                                                VerticalAlignment="Center"
                                                Click="HotkeyRow_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="WinModifierToggle"
                                      Grid.Column="0"
                                      Content="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Hotkeys.WinCheck]}"
                                      ToolTip="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Hotkeys.WinCheckTip]}"
                                      VerticalAlignment="Center"
                                      FontSize="{DynamicResource App.FontSize.Caption}" />

                            <Button Grid.Column="1"
                                    Content="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Hotkeys.Reset]}"
                                    Style="{StaticResource StandardButton}"
                                    ToolTip="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Hotkeys.ResetTip]}"
                                    VerticalAlignment="Center"
                                    Click="ResetHotkeys_Click" />
                        </Grid>

                        <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Hotkeys.Hint]}"
                                   Margin="0,8,0,2"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource App.FontSize.Caption}"
                                   Foreground="{DynamicResource App.TextTertiary}" />
                        </StackPanel>
                    </Border>

                    <!-- ==================== 关于与操作 ==================== -->
                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Group.Other]}"
                               Margin="2,22,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.RestoreAll.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.RestoreAll.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding Source={x:Static services:Loc.Instance}, Path=[Common.RestoreAll]}"
                                        Style="{StaticResource StandardButton}"
                                        VerticalAlignment="Center"
                                        Click="RestoreAll_Click" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Repair.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Repair.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Repair.Button]}"
                                        Style="{StaticResource StandardButton}"
                                        VerticalAlignment="Center"
                                        Click="RepairDegraded_Click" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.ConfigPath.Title]}" />
                                    <TextBlock Text="{Binding ConfigPathText}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.ConfigPath.Open]}"
                                        Style="{StaticResource StandardButton}"
                                        VerticalAlignment="Center"
                                        Click="OpenConfigDir_Click" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Exit.Title]}" />
                                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Exit.Description]}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding Source={x:Static services:Loc.Instance}, Path=[Settings.Exit.Button]}"
                                        Style="{StaticResource StandardButton}"
                                        VerticalAlignment="Center"
                                        Click="Exit_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Source={x:Static services:Loc.Instance}, Path=[Footer.Version]}"
                               Margin="2,22,0,0"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextTertiary}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>