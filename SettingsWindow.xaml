<Window x:Class="TrayHider.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.Background}"
        FontFamily="{DynamicResource App.FontFamily}"
        FontSize="{DynamicResource App.FontSize.Body}"
        Foreground="{DynamicResource App.TextPrimary}"
        UseLayoutRounding="True"
        WindowStyle="None">

    <Border Background="{DynamicResource App.Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="48" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="设置"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource App.FontSize.Subtitle}"
                           FontWeight="SemiBold" />
                <Button Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,8,0"
                        Click="Close_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="20,4,20,24">

                    <!-- ==================== 启动与后台 ==================== -->
                    <TextBlock Text="启动与后台"
                               Margin="2,0,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <StackPanel>
                            <!-- 开机自启 -->
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="开机自动启动" />
                                    <TextBlock Text="登录 Windows 后自动在后台运行，并恢复上次的隐藏状态。"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="14,0" />

                            <!-- 隐藏自身托盘图标 -->
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="隐藏本软件的托盘图标" />
                                    <TextBlock Text="{Binding SelfIconHint}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding HideSelfTrayIcon, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="14,0" />

                            <!-- 关闭行为 -->
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="关闭窗口时最小化到托盘" />
                                    <TextBlock Text="关闭后隐藏守护继续运行，避免已隐藏的图标重新出现。"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==================== 快捷键 ==================== -->
                    <TextBlock Text="唤出主窗口的快捷键"
                               Margin="2,22,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="当前快捷键" />
                                <TextBlock Text="无论本软件图标是否隐藏，都可用该快捷键唤出主窗口。"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource App.FontSize.Caption}"
                                           Foreground="{DynamicResource App.TextTertiary}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource App.ControlFill}"
                                    BorderBrush="{DynamicResource App.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding HotkeyText}"
                                           FontFamily="Consolas"
                                           FontSize="{DynamicResource App.FontSize.Caption}" />
                            </Border>
                        </Grid>

                        <Button x:Name="ChangeHotkeyButton"
                                Content="修改快捷键"
                                Style="{StaticResource StandardButton}"
                                Margin="0,12,0,0"
                                Click="ChangeHotkey_Click" />
                        </StackPanel>
                    </Border>

                    <!-- ==================== 关于与操作 ==================== -->
                    <TextBlock Text="其他"
                               Margin="2,22,0,8"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextSecondary}" />

                    <Border Background="{DynamicResource App.CardBackground}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="恢复所有被隐藏的图标" />
                                    <TextBlock Text="清空隐藏记录。图标将在对应程序重新注册后回到托盘。"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="全部恢复"
                                        Style="{StaticResource StandardButton}"
                                        VerticalAlignment="Center"
                                        Click="RestoreAll_Click" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="配置文件位置" />
                                    <TextBlock Text="{Binding ConfigPathText}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="打开目录"
                                        Style="{StaticResource StandardButton}"
                                        VerticalAlignment="Center"
                                        Click="OpenConfigDir_Click" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource App.Divider}" Margin="0,14,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="退出程序" />
                                    <TextBlock Text="退出后将不再隐藏任何图标。"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource App.FontSize.Caption}"
                                               Foreground="{DynamicResource App.TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="退出"
                                        Style="{StaticResource StandardButton}"
                                        VerticalAlignment="Center"
                                        Click="Exit_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="托盘图标管家 v1.1.0"
                               Margin="2,22,0,0"
                               FontSize="{DynamicResource App.FontSize.Caption}"
                               Foreground="{DynamicResource App.TextTertiary}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
