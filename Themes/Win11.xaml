<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================ 基础色板
         浅色为默认值，运行时由 WindowChrome.ApplyThemeResources 按系统主题替换。
         ============================================================ -->

    <SolidColorBrush x:Key="App.Background" Color="#F3F3F3" />
    <SolidColorBrush x:Key="App.CardBackground" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="App.CardBackgroundHover" Color="#D8FFFFFF" />
    <SolidColorBrush x:Key="App.TextPrimary" Color="#1A1A1A" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#5A5A5A" />
    <SolidColorBrush x:Key="App.TextTertiary" Color="#767676" />
    <SolidColorBrush x:Key="App.Border" Color="#20000000" />
    <SolidColorBrush x:Key="App.Divider" Color="#14000000" />
    <SolidColorBrush x:Key="App.ControlFill" Color="#FDFDFD" />
    <SolidColorBrush x:Key="App.ControlFillHover" Color="#F5F5F5" />
    <SolidColorBrush x:Key="App.ControlFillPressed" Color="#EBEBEB" />
    <SolidColorBrush x:Key="App.Accent" Color="#005FB8" />
    <SolidColorBrush x:Key="App.AccentText" Color="#FFFFFF" />

    <!-- ============================================================ 排版 -->

    <FontFamily x:Key="App.FontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <sys:Double x:Key="App.FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="App.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="App.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="App.FontSize.Subtitle">15</sys:Double>

    <CornerRadius x:Key="App.Corner.Small">4</CornerRadius>
    <CornerRadius x:Key="App.Corner.Medium">8</CornerRadius>
    <CornerRadius x:Key="App.Corner.Large">12</CornerRadius>

    <!-- ============================================================ 窗口标题栏按钮 -->

    <Style x:Key="CaptionButtonBase" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ 通用按钮 -->

    <Style x:Key="StandardButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource App.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource App.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimary}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{DynamicResource App.ControlFill}"
                            BorderBrush="{DynamicResource App.Border}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource App.ControlFillPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
        <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{DynamicResource App.Accent}"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 开关（ToggleSwitch）

         严格对齐 Win11 设置应用的 ToggleSwitch 视觉：
         轨道 40x20，圆角 10，滑块 12，左侧关闭 / 右侧开启。
         ============================================================ -->

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Track"
                                Width="40" Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource App.ControlFill}"
                                BorderBrush="{DynamicResource App.TextSecondary}"
                                BorderThickness="1.4">
                            <Ellipse x:Name="Knob"
                                     Width="12" Height="12"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     Fill="{DynamicResource App.TextSecondary}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource App.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 复选框（列表勾选用）

         Win11 风格：未选中为细边框方块，选中为主题色填充 + 白色对勾。
         ============================================================ -->

    <Style x:Key="ListCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="20" Height="20">
                        <Border x:Name="Box"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="{DynamicResource App.TextSecondary}"
                                BorderThickness="1.4" />
                        <Path x:Name="Check"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              Stroke="{DynamicResource App.AccentText}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 1,6.5 L 4.5,10 L 11,2"
                              Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.ControlFill}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 滚动条 -->

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="4"
                                                CornerRadius="2"
                                                Background="{DynamicResource App.TextTertiary}"
                                                Opacity="0.5"
                                                Margin="3,0,3,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
